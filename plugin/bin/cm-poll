#!/usr/bin/env bash

. "$(dirname "$0")/../lib.sh"
[ -n "$CM_URL" ] || exit 0

PID="$CM_DIR/poll.pid"
CURSOR="$CM_DIR/cursor"
OUT="$CM_DIR/poll.out"

poller_alive "$(cat "$PID" 2>/dev/null)" && exit 0
echo $$ >"$PID"

(
  while :; do
    api POST /heartbeat "$(jq -nc --arg a "$ACTOR" '{actor: $a}')" >/dev/null 2>>"$LOG"
    [ $? -eq 22 ] && kill -USR1 $$
    sleep 5
  done
) &
hb=$!
req=""
rejoin=""

cleanup() {
  kill "$hb" $req 2>/dev/null
  [ "$(cat "$PID" 2>/dev/null)" = $$ ] && rm -f "$PID"
  exit 0
}
trap cleanup TERM INT HUP
trap 'rejoin=1; kill $req 2>/dev/null' USR1

pause() {
  sleep "$1" &
  wait $!
}

WIN_NOTIFY='Add-Type -AssemblyName System.Windows.Forms, System.Drawing; $n = New-Object System.Windows.Forms.NotifyIcon; $n.Icon = [System.Drawing.SystemIcons]::Information; $n.Visible = $true; $n.ShowBalloonTip(10000, $env:CM_NOTE_TITLE, $env:CM_NOTE_TEXT, [System.Windows.Forms.ToolTipIcon]::Info); Start-Sleep -Seconds 10; $n.Dispose()'

notify() {
  local title="CaptainMorgue: $1 from $2" text="${3:-(no text)}"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' \
      "$title" "$text" >/dev/null 2>>"$LOG"
  elif command -v powershell.exe >/dev/null 2>&1; then
    CM_NOTE_TITLE=$title CM_NOTE_TEXT=$text WSLENV="CM_NOTE_TITLE:CM_NOTE_TEXT${WSLENV:+:$WSLENV}" \
      powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command "$WIN_NOTIFY" >/dev/null 2>>"$LOG" &
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -- "$title" "$text" 2>>"$LOG"
  else
    printf '\a%s %s: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$title" "$text"
  fi
}

alert() {
  if [ "${CM_NOTIFY:-}" = off ]; then
    log "alert $1 from $2 (seq $3) not shown, CM_NOTIFY=off"
    return
  fi
  if ! command -v osascript >/dev/null 2>&1; then
    notify "$1" "$2" "$4"
    return
  fi
  osascript -e 'on run argv' \
    -e 'set r to display dialog (item 2 of argv) with title (item 1 of argv) buttons {"Later", "Open"} default button "Open" giving up after ((item 4 of argv) as integer)' \
    -e 'if button returned of r is "Open" and item 3 of argv is not "" then tell application id (item 3 of argv) to activate' \
    -e 'end run' "CaptainMorgue: $1 from $2 (seq $3)" "${4:-(no text)}" "${__CFBundleIdentifier:-}" "${CM_ALERT_SECONDS:-3600}" >/dev/null 2>>"$LOG" &
}

vote() {
  local body
  body=$(jq -c --arg a "$ACTOR" --argjson ours "$(read_seq "$SEEN")" '
    (.candidate // .from) as $who
    | (.candidate_cursor // .cursor // [.text | capture("cursor (?<c>[0-9]+)")? | .c | tonumber][0]) as $c
    | {actor: $a, term, candidate: $who, granted: ($who == $a or $c == null or $c >= $ours)}' <<<"$1" 2>>"$LOG") || return
  api POST "/incidents/$INCIDENT/vote" "$body" >/dev/null 2>>"$LOG" && log "voted $body"
}

delay=1
while :; do
  if [ -n "$rejoin" ]; then
    rejoin=""
    team=$(jq -r '.team // empty' "$SESSION" 2>/dev/null)
    role=$(jq -r '.role // empty' "$SESSION" 2>/dev/null)
    join_incident "${team:-${CM_TEAM:-}}" "${role:-${CM_ROLE:-}}" "${CM_TASK:-}" >/dev/null && log "rejoined $INCIDENT after the service forgot $ACTOR"
  fi
  cursor=$(read_seq "$CURSOR")
  started=$SECONDS
  CM_MAX_TIME=35 api GET "/inbox/$ACTOR?after=$cursor&wait=25" >"$OUT" 2>>"$LOG" &
  req=$!
  if ! wait "$req"; then
    req=""
    pause "$delay"
    delay=$((delay * 2 > 30 ? 30 : delay * 2))
    continue
  fi
  req=""
  delay=1

  new=$(jq -c --argjson c "$cursor" '[.messages[]? | select(.seq > $c)] | sort_by(.seq) | .[]' "$OUT" 2>>"$LOG")
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    printf '%s\n' "$m" >>"$INBOX"
    IFS=$'\t' read -r kind from priority seq text < <(jq -r '[.kind, .from, .priority, .seq, .text] | @tsv' <<<"$m")
    if [ "$kind" = vote_request ]; then
      vote "$m"
    elif [ "$priority" = interrupt ] || [ "$kind" = join ]; then
      alert "$kind" "$from" "$seq" "$text"
    fi
  done <<<"$new"

  next=$(jq -r --argjson c "$cursor" '[.cursor // 0, (.messages[]?.seq), $c] | max' "$OUT" 2>/dev/null)
  [ -n "$next" ] && [ "$next" != "$cursor" ] && write_file "$CURSOR" "$next"
  [ -n "$new" ] || [ $((SECONDS - started)) -ge 1 ] || pause 1
done
