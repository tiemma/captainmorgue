#!/usr/bin/env bash

. "$(dirname "$0")/../lib.sh"
BIN="$(cd "$(dirname "$0")" && pwd)"
SESSION_NAME=captainmorgue

if [ -z "$CM_URL" ]; then
  echo "CM_URL is not set, so CaptainMorgue is off."
  exit 0
fi

with_env() {
  printf '%q ' bash -c '. "$0" && exec "$@"' "$CM_DIR/console.env" "$@"
}

shell_cmd() {
  local sh=${CM_CONSOLE_CMD:-${SHELL:-bash}}
  case "${sh##*/}" in
  zsh)
    mkdir -p "$CM_DIR/zsh"
    echo '[ -f "$HOME/.zshenv" ] && . "$HOME/.zshenv"' >"$CM_DIR/zsh/.zshenv"
    printf 'ZDOTDIR=$HOME\n[ -f "$HOME/.zshrc" ] && . "$HOME/.zshrc"\neval "$(%q shell-hook zsh)"\n' "$BIN/cm" >"$CM_DIR/zsh/.zshrc"
    echo env ZDOTDIR="$CM_DIR/zsh" "$sh"
    ;;
  bash)
    printf '[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"\neval "$(%q shell-hook bash)"\n' "$BIN/cm" >"$CM_DIR/bashrc"
    echo "$sh" --rcfile "$CM_DIR/bashrc"
    ;;
  *) echo "$sh" ;;
  esac
}

console() {
  local v
  (
    umask 077
    for v in CM_URL CM_ACTOR CM_TEAM CM_TOKEN CM_INCIDENT CM_LEDGER; do
      [ -n "${!v:-}" ] && printf 'export %s=%q\n' "$v" "${!v}"
    done >"$CM_DIR/console.env"
  )
  if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is not installed. Run the CaptainMorgue pane in a second terminal next to this one:"
    echo "  $BIN/cm pane"
    return
  fi
  if [ -n "${TMUX:-}" ]; then
    tmux split-window -h -l 40% "$(with_env "$BIN/cm" pane)" && echo "Opened the CaptainMorgue pane on the right."
    return
  fi
  if ! tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    tmux new-session -d -s "$SESSION_NAME" "$(with_env $(shell_cmd))" \; \
      split-window -h -l 40% "$(with_env "$BIN/cm" pane)" \; select-pane -L || return
  else
    tmux respawn-pane -k -t "$SESSION_NAME:0.1" "$(with_env "$BIN/cm" pane)"
  fi
  [ -t 0 ] && [ -t 1 ] && exec tmux attach -t "$SESSION_NAME"
  echo "The console runs in tmux session $SESSION_NAME. Open it in a terminal with: tmux attach -t $SESSION_NAME"
}

FEED="$CM_DIR/pane.$$.jsonl"
STATE="$CM_DIR/pane.$$.state"
COLORS='{"ask":"1;33","page":"1;31","conflict":"1;31","escalation":"1;31","join":"32","recovered":"32","broadcast":"36","relay":"36"}'
[ -n "${NO_COLOR:-}" ] && COLORS='{}'
JQ_OPEN='def open($me; $done): .kind == "ask" and .from != $me and (.seq as $q | any($done[]; . == $q) | not);'

follow() {
  local c=0 out
  while :; do
    if ! out=$(CM_MAX_TIME=35 api GET "/inbox/$ACTOR?after=$c&wait=25" 2>>"$LOG"); then
      sleep 2
      continue
    fi
    jq -c --argjson c "$c" '[.messages[]? | select(.seq > $c and .kind != "vote_request")] | sort_by(.seq) | .[]' <<<"$out" >>"$FEED"
    c=$(jq -r --argjson c "$c" '[.cursor // 0, (.messages[]?.seq), $c] | max' <<<"$out")
  done
}

refresh() {
  while :; do
    snapshot 3 >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"
    sleep 5
  done
}

fmt() {
  jq -r --arg me "$ACTOR" --argjson colors "$COLORS" --slurpfile done <(cat "$ANSWERED" 2>/dev/null) "$JQ_DEFS$JQ_OPEN"'
    def clock: .ts // "" | sub("\\.[0-9]+"; "") | try (fromdateiso8601 | strflocaltime("%H:%M:%S")) catch "--:--:--";
    def paint($k): ($colors[$k] // "") as $c | if $c == "" then . else "\u001b[\($c)m\(.)\u001b[0m" end;
    .kind as $k
    | "\(clock) \(msgline | ltrimstr("- "))" as $l
    | if open($me; $done) then "\($l)\n    answer: \(.seq) <text> | \(.seq) on | \(.seq) @someone" | paint("ask") else $l | paint($k) end'
}

show() {
  [ "$2" -gt "$1" ] || return 0
  sed -n "$(($1 + 1)),$2p" "$FEED" | fmt
}

open_asks() {
  jq -c --arg me "$ACTOR" --slurpfile done <(cat "$ANSWERED" 2>/dev/null) "$JQ_OPEN"'select(open($me; $done))' "$FEED"
}

on_state() {
  if [ -s "$STATE" ]; then
    jq -r "$@" "$STATE"
  else
    echo "Waiting for the incident state."
  fi
}

status_line() {
  on_state --arg me "$ACTOR" --arg inc "$INCIDENT" --arg asks "$(open_asks | wc -l | tr -d ' ')" "$JQ_DEFS"'
    "\($inc) | commander \(commander) | you: \(roles($me)) | open asks \($asks) | online: "
    + ([.state.people // {} | to_entries[] | select(.value | objects | .status == "online") | .key] | join(", ") | name_or_none)'
}

who() {
  on_state "$JQ_DEFS"'
    [.state.people // {} | to_entries[] | select(.value | objects | .status != "offline") | .key] as $on
    | if $on == [] then "Nobody online." else $on[] as $a | "  \($a) (\(status_of($a)), team \(team_of($a)), \(roles($a))): \(task_of($a))" end'
}

targets() {
  [ -s "$STATE" ] && jq -r '"@" + ((.state.people // {} | to_entries[] | select(.value | objects | .last_seen) | .key), .state.teams[]?.id)' "$STATE"
}

usage() {
  printf '  <seq> <text> reply   <seq> on  "On it"   <seq> @who  route to someone\n'
  printf '  b [@team|root] <text> broadcast   a @who <text> ask   o open asks   w who is online\n'
  printf '  s status   l redraw   ? help   q quit   Tab completes, Up/Down history\n'
}

redraw() {
  printf '\033[2J\033[H'
  printf 'CaptainMorgue %s as %s\n' "$INCIDENT" "$ACTOR"
  usage
  status_line
  echo
  shown=$(wc -l <"$FEED" | tr -d ' ')
  show 0 "$shown"
}

reply() {
  "$BIN/cm" reply <<<"$1 $2"
}

route() {
  local question
  question=$(jq -r --argjson s "$1" 'select(.seq == $s) | "\(.text) (asked by \(.from))"' "$FEED" | head -1)
  if [ -z "$question" ]; then
    echo "No message with seq $1."
    return
  fi
  "$BIN/cm" ask <<<"$2 $question" && reply "$1" "Not me, asked $2"
}

answer() {
  local seq=${1%%[!0-9]*} rest
  rest=${1#"$seq"}
  rest=${rest#"${rest%%[![:space:]]*}"}
  case "$rest" in
  "") echo "Add the answer after the seq: $seq <text>, $seq on, or $seq @who." ;;
  on) reply "$seq" "On it" ;;
  @?*) route "$seq" "${rest%%[[:space:]]*}" ;;
  *) reply "$seq" "$rest" ;;
  esac
}

complete_word() {
  local word head first list c p cands=()
  word=${buf##*[[:space:]]}
  head=${buf%"$word"}
  first=${buf%%[[:space:]]*}
  if [ -z "$head" ]; then
    list="a b help l o q s w $(open_asks | jq -r .seq)"
  else
    list=$(targets)
    if [ "$head" = "$first " ]; then
      case "$first" in
      b) list="root $list" ;;
      [0-9]*) list="on $list" ;;
      esac
    fi
  fi
  for c in $list; do
    case "$c" in "$word"*) cands+=("$c") ;; esac
  done
  case ${#cands[@]} in
  0) return ;;
  1) buf="$head${cands[0]} " ;;
  *)
    p=${cands[0]}
    for c in "${cands[@]}"; do
      while [ -n "$p" ] && [ "${c#"$p"}" = "$c" ]; do p=${p%?}; done
    done
    if [ ${#p} -gt ${#word} ]; then
      buf=$head$p
    else
      printf '\r\033[K%s\n' "${cands[*]}"
    fi
    ;;
  esac
}

run() {
  case "$1" in
  q | quit) exit 0 ;;
  "" | l) redraw ;;
  help | "?") usage ;;
  s) status_line ;;
  w) who ;;
  o) open_asks | fmt | grep . || echo "No open asks." ;;
  b | b[[:space:]]*) "$BIN/cm" broadcast <<<"${1#b}" ;;
  a[[:space:]]*) "$BIN/cm" ask <<<"${1#a}" ;;
  [0-9]*) answer "$1" ;;
  *) echo "Unknown command. ? shows the help." ;;
  esac
}

prompt() {
  printf '\r\033[K> %s' "$buf"
}

pane() {
  : >"$FEED"
  follow &
  POLL=$!
  snapshot 3 >"$STATE" 2>>"$LOG"
  refresh 2>>"$LOG" &
  REFRESH=$!
  local shown=0 n k esc buf="" hist=() hi=0 tty=""
  [ -t 0 ] && tty=$(stty -g) && stty -echo
  trap 'kill $POLL $REFRESH 2>/dev/null; rm -f "$FEED" "$STATE" "$STATE.tmp"; [ -n "$tty" ] && stty "$tty"' EXIT
  trap 'exit 0' INT TERM HUP
  redraw
  prompt
  while :; do
    n=$(wc -l <"$FEED" | tr -d ' ')
    if [ "$n" -gt "$shown" ]; then
      printf '\r\033[K'
      show "$shown" "$n"
      sed -n "$((shown + 1)),${n}p" "$FEED" | grep -q '"kind":"ask"' && printf '\a'
      shown=$n
      prompt
    fi
    IFS= read -rsn1 -d '' -t 1 k
    case $? in
    0) ;;
    1) [ -n "$tty" ] && continue || break ;;
    *) continue ;;
    esac
    case "$k" in
    $'\r' | $'\n')
      echo
      [ -n "$buf" ] && hist+=("$buf")
      hi=${#hist[@]}
      k=$buf buf=""
      run "$k"
      ;;
    $'\t') complete_word ;;
    $'\177' | $'\b') buf=${buf%?} ;;
    $'\025') buf="" ;;
    $'\004') [ -z "$buf" ] && break ;;
    $'\033')
      IFS= read -rsn2 -t 1 esc
      case "$esc" in
      "[A" | OA) [ "$hi" -gt 0 ] && hi=$((hi - 1)) && buf=${hist[hi]} ;;
      "[B" | OB) [ "$hi" -lt ${#hist[@]} ] && hi=$((hi + 1)) && buf=${hist[hi]:-} ;;
      esac
      ;;
    "") continue ;;
    *)
      buf+=$k
      printf '%s' "$k"
      continue
      ;;
    esac
    prompt
  done
}

case "$1" in
console) console ;;
pane) pane ;;
esac
