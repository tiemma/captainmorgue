{
  "extraKnownMarketplaces": {
    "captainmorgue": {
      "source": {
        "source": "github",
        "repo": "tiemma/captainmorgue"
      }
    }
  },
  "enabledPlugins": {
    "captainmorgue@captainmorgue": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/team-context.sh", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/team-context.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/ledger-reminder.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
